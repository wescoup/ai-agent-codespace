{
  "name": "Agent-Lab-Personal",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "mhutchie.git-graph",
        "christian-kohler.path-intellisense"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && echo 'Personal Agent Lab is ready!' > ready.txt",
  "remoteUser": "vscode"
}
